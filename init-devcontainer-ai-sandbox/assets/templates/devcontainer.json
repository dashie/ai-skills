// AI sandbox for {{PROJECT_NAME}}.
// Isolation model: no host home, no Docker socket, no credentials, non-root user,
// dropped capabilities, bounded resources. See docs/AGENT-SANDBOX.md.
{
  "name": "{{PROJECT_NAME}} - AI sandbox",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "BASE_IMAGE": "{{BASE_IMAGE}}"
    }
  },

  "remoteUser": "dev",
  "containerUser": "dev",
  "init": true,

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // Named volumes only: nothing from the host home directory is exposed.
  "mounts": [
    "source={{PROJECT_SLUG}}-copilot,target=/home/dev/.copilot,type=volume",
    "source={{PROJECT_SLUG}}-npm,target=/home/dev/.npm,type=volume",
    "source={{PROJECT_SLUG}}-cache,target=/home/dev/.cache,type=volume",
    "source={{PROJECT_SLUG}}-local,target=/home/dev/.local,type=volume"
  ],

  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--memory={{MEMORY_LIMIT}}",
    "--cpus={{CPU_LIMIT}}",
    "--pids-limit=2048",
    "--hostname=agent-sandbox"
  ],

  "containerEnv": {
    "COPILOT_HOME": "/home/dev/.copilot",
    "GIT_CONFIG_GLOBAL": "/home/dev/.gitconfig",
    "GIT_TERMINAL_PROMPT": "0",
    "DEBIAN_FRONTEND": "noninteractive",
    "TZ": "UTC"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": {{VSCODE_EXTENSIONS}},
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.enableCommitSigning": false,
        "git.postCommitCommand": "none",

        // Chat autonomy, scoped to the sandbox. These replace the CLI flags
        // (--allow-all, --no-ask-user) which do not apply to the chat UI.
        "chat.permissions.default": "autoApprove",
        "chat.agent.maxRequests": 300,
        "chat.tools.terminal.enableAutoApprove": true,
        // Destructive and history-changing commands still ask, so an unattended
        // run cannot delete work or touch Git by accident.
        "chat.tools.terminal.autoApprove": {
          "rm": false,
          "rmdir": false,
          "del": false,
          "kill": false,
          "curl": false,
          "wget": false,
          "eval": false,
          "chmod": false,
          "chown": false,
          "/^git\\s+(commit|push|tag|merge|rebase|reset|clean)/i": false
        }
      }
    }
  },

  "forwardPorts": {{FORWARD_PORTS}}
}
