// AI sandbox for {{PROJECT_NAME}}.
// Isolation model: no host home, no Docker socket, no credentials, non-root user,
// dropped capabilities, bounded resources. See docs/agent-sandbox.md.
{
  "name": "{{PROJECT_NAME}} - AI sandbox",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "BASE_IMAGE": "{{BASE_IMAGE}}"
    }
  },

  "remoteUser": "dev",
  "containerUser": "dev",
  "init": true,

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // Named volumes only, plus one read-only bind mount: the single exception is the
  // Copilot skills repository, which holds the agent tooling and no credentials.
  // Nothing else from the host home directory is exposed.
  "mounts": [
    "source={{PROJECT_SLUG}}-copilot,target=/home/dev/.copilot,type=volume",
    "source={{PROJECT_SLUG}}-npm,target=/home/dev/.npm,type=volume",
    "source={{PROJECT_SLUG}}-cache,target=/home/dev/.cache,type=volume",
    "source={{PROJECT_SLUG}}-local,target=/home/dev/.local,type=volume",
    "source=${localEnv:HOME}/.copilot/skills,target=/home/dev/.copilot/skills,type=bind,readonly"
  ],

  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--memory={{MEMORY_LIMIT}}",
    "--cpus={{CPU_LIMIT}}",
    "--pids-limit=2048",
    // `ping` runs capless in the image, so it needs the unprivileged ICMP datagram
    // range instead of CAP_NET_RAW; the container netns keeps it scoped locally.
    "--sysctl=net.ipv4.ping_group_range=0 2147483647",
    "--hostname=agent-sandbox"
  ],

  "containerEnv": {
    "COPILOT_HOME": "/home/dev/.copilot",
    "GIT_CONFIG_GLOBAL": "/home/dev/.gitconfig",
    "GIT_TERMINAL_PROMPT": "0",
    "DEBIAN_FRONTEND": "noninteractive",
    "TZ": "UTC"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      // Workspace extensions, installed inside the container. Any extension that
      // contributes Copilot Chat models (languageModelChatProviders) must be listed
      // here, or its models never reach the model picker in this window.
      "extensions": {{VSCODE_EXTENSIONS}},
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.enableCommitSigning": false,
        "git.postCommitCommand": "none",

        // Chat autonomy, scoped to the sandbox. These replace the CLI flags
        // (--allow-all, --no-ask-user) which do not apply to the chat UI.
        "chat.permissions.default": "autoApprove",
        "chat.agent.maxRequests": 300,
        "chat.tools.terminal.enableAutoApprove": true,
        "chat.tools.terminal.autoApprove": {
          // The skills repository mounted at /home/dev/.copilot/skills is agent
          // tooling: its `aispec` dispatcher runs without a prompt, so a long run
          // never stalls on one.
          "aispec": true,
          // Destructive and history-changing commands still ask, so an unattended
          // run cannot delete work or touch Git by accident.
          "rm": false,
          "rmdir": false,
          "del": false,
          "kill": false,
          "curl": false,
          "wget": false,
          "eval": false,
          "chmod": false,
          "chown": false,
          "/^git\\s+(commit|push|tag|merge|rebase|reset|clean)/i": false
        }
      }
    }
  },

  "forwardPorts": {{FORWARD_PORTS}}
}
